# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ============================================================
# BetStats COP - MongoDB Atlas & Vercel Production Environment
# ============================================================

# MONGODB_URI: Cadena de conexión a MongoDB Atlas
# Formato: mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI="mongodb+srv://betstats_user:TU_PASSWORD_AQUI@cluster0.mongodb.net/betstats_cop?retryWrites=true&w=majority"

# AUTH_SECRET: Clave secreta para JWT y cifrado de sesión de usuarios
AUTH_SECRET="tu_clave_secreta_jwt_de_al_menos_32_caracteres"

# NEXT_PUBLIC_DEFAULT_CURRENCY: Moneda por defecto
NEXT_PUBLIC_DEFAULT_CURRENCY="COP"
